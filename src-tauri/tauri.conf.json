{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图文坊",
  "version": "1.0.1",
  "identifier": "com.wappkit.tuwenfang",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "图文坊 WappKit",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "WappKit",
    "copyright": "基于 MarkCardStudio (GPL-3.0) 二次开发",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2QTMyRjA3RjAzMDk0RkEKUldUNmxERHdCeStqTnU5SjFPWE9GdGZrUnRSdWROSkpGL3BSWmNObzRhS0pUUzJVMnlvY2JhaXgK",
      "endpoints": [
        "https://github.com/wappkit/tuwen-fang/releases/latest/download/latest.json"
      ]
    }
  }
}
